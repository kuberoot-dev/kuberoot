#!/bin/bash
# SSH over isolated observer NIC; traffic generated by the command uses guest routes.
set -euo pipefail
case ${1:?guest} in client) port=2231;; gateway) port=2232;; sink) port=2233;; debian) port=2222;; *) exit 2;; esac
shift
exec ssh -o BatchMode=yes -o ConnectTimeout=5 -o LogLevel=ERROR -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -i /work/field/private/id_ed25519 -p "$port" root@127.0.0.1 "$@"
