{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "kr-router-stand",
    "namespace": "tenant-kuberoot"
  },
  "spec": {
    "containers": [
      {
        "command": [
          "sh",
          "-c",
          "mkdir -p /work/tmp && exec sleep infinity"
        ],
        "env": [
          {
            "name": "TMPDIR",
            "value": "/work/tmp"
          }
        ],
        "image": "debian:bookworm",
        "imagePullPolicy": "IfNotPresent",
        "name": "tools",
        "resources": {
          "limits": {
            "cpu": "6",
            "devices.kubevirt.io/kvm": "1",
            "ephemeral-storage": "2Gi",
            "memory": "14Gi"
          },
          "requests": {
            "cpu": "500m",
            "devices.kubevirt.io/kvm": "1",
            "ephemeral-storage": "50Mi",
            "memory": "2Gi"
          }
        },
        "terminationMessagePath": "/dev/termination-log",
        "terminationMessagePolicy": "File",
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work"
          },
          {
            "mountPath": "/var/run/secrets/kubernetes.io/serviceaccount",
            "name": "kube-api-access-mk8bn",
            "readOnly": true
          },
          {
            "name": "tun",
            "mountPath": "/dev/net/tun"
          }
        ],
        "securityContext": {
          "capabilities": {
            "add": [
              "NET_ADMIN"
            ]
          }
        }
      }
    ],
    "dnsPolicy": "ClusterFirst",
    "enableServiceLinks": true,
    "preemptionPolicy": "PreemptLowerPriority",
    "priority": 0,
    "restartPolicy": "Always",
    "schedulerName": "linstor-scheduler",
    "securityContext": {},
    "serviceAccount": "default",
    "serviceAccountName": "default",
    "terminationGracePeriodSeconds": 30,
    "tolerations": [
      {
        "effect": "NoExecute",
        "key": "node.kubernetes.io/not-ready",
        "operator": "Exists",
        "tolerationSeconds": 300
      },
      {
        "effect": "NoExecute",
        "key": "node.kubernetes.io/unreachable",
        "operator": "Exists",
        "tolerationSeconds": 300
      }
    ],
    "volumes": [
      {
        "name": "work",
        "persistentVolumeClaim": {
          "claimName": "kr-router-stand-work"
        }
      },
      {
        "name": "kube-api-access-mk8bn",
        "projected": {
          "defaultMode": 420,
          "sources": [
            {
              "serviceAccountToken": {
                "expirationSeconds": 3607,
                "path": "token"
              }
            },
            {
              "configMap": {
                "items": [
                  {
                    "key": "ca.crt",
                    "path": "ca.crt"
                  }
                ],
                "name": "kube-root-ca.crt"
              }
            },
            {
              "downwardAPI": {
                "items": [
                  {
                    "fieldRef": {
                      "apiVersion": "v1",
                      "fieldPath": "metadata.namespace"
                    },
                    "path": "namespace"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "name": "tun",
        "hostPath": {
          "path": "/dev/net/tun",
          "type": "CharDevice"
        }
      }
    ]
  }
}