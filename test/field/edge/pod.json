{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "kr-edge-stand",
    "namespace": "tenant-kuberoot",
    "labels": {
      "app": "kr-edge-stand"
    }
  },
  "spec": {
    "containers": [
      {
        "command": [
          "bash",
          "-c",
          "mkdir -p /work/tmp; exec sleep infinity"
        ],
        "env": [
          {
            "name": "TMPDIR",
            "value": "/work/tmp"
          }
        ],
        "image": "debian:bookworm",
        "imagePullPolicy": "IfNotPresent",
        "name": "tools",
        "resources": {
          "limits": {
            "cpu": "6",
            "devices.kubevirt.io/kvm": "1",
            "ephemeral-storage": "2Gi",
            "memory": "14Gi"
          },
          "requests": {
            "cpu": "500m",
            "devices.kubevirt.io/kvm": "1",
            "ephemeral-storage": "50Mi",
            "memory": "2Gi"
          }
        },
        "terminationMessagePath": "/dev/termination-log",
        "terminationMessagePolicy": "File",
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work"
          },
          {
            "name": "tun",
            "mountPath": "/dev/net/tun"
          }
        ],
        "securityContext": {
          "capabilities": {
            "add": [
              "NET_ADMIN"
            ]
          }
        }
      }
    ],
    "restartPolicy": "Always",
    "securityContext": {},
    "terminationGracePeriodSeconds": 30,
    "volumes": [
      {
        "name": "work",
        "persistentVolumeClaim": {
          "claimName": "kr-edge-stand-work"
        }
      },
      {
        "name": "tun",
        "hostPath": {
          "path": "/dev/net/tun",
          "type": "CharDevice"
        }
      }
    ]
  }
}
