+            for id in 0..config.vcpu_count as u32 {
+                let vcpu = vm.create_vcpu(id, None).unwrap();
+                let mut init = vcpu.create_vcpu_init();
+                vm.get_preferred_target(&mut init).unwrap();
+                vcpu.vcpu_init(&init).unwrap();
+                vcpus.push(vcpu);
+            }
+            let gic = KvmGicV2::new(vm.as_any().downcast_ref::<KvmVm>().unwrap(), config).unwrap();
+            (vm, vcpus, gic)
+        }
+
+        fn read(gic: &KvmGicV2, group: u32, cpu: u32, offset: u32) -> u32 {
+            let mut value = 0_u32;
+            let mut attribute = kvm_bindings::kvm_device_attr {
+                group,
+                attr: (u64::from(cpu) << 32) | u64::from(offset),
+                addr: &raw mut value as u64,
+                flags: 0,
+            };
+            // SAFETY: The VGICv2 attribute receives exactly one writable u32.
+            unsafe { gic.device.get_device_attr(&mut attribute) }.unwrap();
+            value
+        }
+
+        fn write(gic: &KvmGicV2, group: u32, cpu: u32, offset: u32, value: u32) {
+            gic.set_attr(
+                group,
+                (u64::from(cpu) << 32) | u64::from(offset),
+                &raw const value as u64,
+            )
+            .unwrap();
+        }
+
+        let mut config = config();
+        config.vcpu_count = 2;
+        let (_source_vm, _source_cpus, source) = controller(&config);
+        let (_target_vm, _target_cpus, mut target) = controller(&config);
+        // Enable userspace group restoration before programming the source.
+        write(&source, DIST, 0, 8, read(&source, DIST, 0, 8));
+        for (offset, value) in [
+            (0xc08, 0),   // SPI32..47: level (KVM's reset default is edge).
+            (0xc20, 0xa), // SPI128 and SPI129 are edge-triggered.
+            (0x880, 0x0102),
+            (0x480, 0x2010),
+            (0x090, 3),
+            (0x110, 3),
+            (0x210, 1),
+            (0x310, 2),
+        ] {
+            write(&source, DIST, 0, offset, value);
+        }
+        assert_eq!(
+            read(&source, DIST, 0, 0xc08) & (1 << 17),
+            0,
+            "SPI40 must be level-triggered for the level-source tests"
+        );
+        for cpu in 0..2 {
+            write(&source, CPU, cpu, 0, 0x201);
+            write(&source, CPU, cpu, 4, 31 - cpu); // Raw KVM PMR encoding.
+            write(&source, CPU, cpu, 8, 3 + cpu);
+            write(&source, CPU, cpu, 0x1c, 4 + cpu);
+            write(&source, CPU, cpu, 0xd0, 1 << (cpu + 2));
+            write(&source, DIST, cpu, 0x80, (1 << 27) | (1 << 30));
+            write(&source, DIST, cpu, 0x100, (1 << 27) | (1 << 30) | 0xffff);
+            write(&source, DIST, cpu, 0x410, 0x3020_1000);
+        }
+        // Foreign SGI sources must not turn into self sources on restore.
+        write(&source, DIST, 0, 0xf24, 2 << 8); // SGI5 from CPU1.
+        write(&source, DIST, 1, 0xf24, 1 << 24); // SGI7 from CPU0.
+        write(&source, DIST, 0, 0x200, (1 << 27) | (1 << 30));
+        write(&source, DIST, 0, 0x300, 1 << 27);
+        write(&source, DIST, 0, 0x304, 1 << 8); // Active level SPI40, no pending input.
+        write(&source, DIST, 0, 0, 1);
+
+        let snapshot = source.state().unwrap();
+        let expected = serde_json::to_value(&snapshot).unwrap();
+        assert_eq!(expected["KvmV2"]["cpus"][0]["sgi_sources"][1], 2 << 8);
+        assert_eq!(expected["KvmV2"]["cpus"][1]["sgi_sources"][1], 1 << 24);
+        // Capture from real KVM must reject these states without modifying it.
+        for (set, clear, value, reason) in [
+            (0x300, 0x380, 1, "active SGIs"),
+            (0x200, 0x280, 1 << 23, "pending level PPIs"),
+            (0x204, 0x284, 1 << 8, "Pending level SPI 40"),
+        ] {
+            write(&source, DIST, 0, set, value);
+            let programmed = read(&source, DIST, 0, set);
+            assert_eq!(
+                programmed & value,
+                value,
+                "KVM did not expose {reason}: register={set:#x}, wrote={value:#x}, read={programmed:#x}"
+            );
+            let error = source.state().err().unwrap_or_else(|| {
+                panic!("Unsupported {reason} was accepted: register={set:#x}, programmed={programmed:#x}")
+            });
+            assert!(error.to_string().contains(reason), "{error}");
+            assert_ne!(read(&source, DIST, 0, set) & value, 0);
+            eprintln!("Rejected {reason}: register={set:#x}, programmed={programmed:#x}");
+            write(&source, DIST, 0, clear, value);
+        }
+        assert_eq!(
+            serde_json::to_value(source.state().unwrap()).unwrap(),
+            expected
+        );
+
+        // Poison saved input, and prove rejection leaves real target unchanged.
+        let before = serde_json::to_value(target.state().unwrap()).unwrap();
+        let mut bad = expected.clone();
+        bad["KvmV2"]["cpus"][0]["active"] = serde_json::json!(1);
+        let bad: GicState = serde_json::from_value(bad).unwrap();
+        assert!(target.set_state(&bad).is_err());
+        assert_eq!(
+            serde_json::to_value(target.state().unwrap()).unwrap(),
+            before
+        );
+
+        // Dirty existing set bits to exercise clear-and-set on real hardware.
+        write(&target, DIST, 0, 0x110, u32::MAX);
+        write(&target, DIST, 0, 0x210, u32::MAX);
+        write(&target, DIST, 0, 0x310, u32::MAX);
+        write(&target, DIST, 0, 0xf24, 0x0303_0303);
+        write(&target, DIST, 1, 0xf24, 0x0303_0303);
+        target.set_state(&snapshot).unwrap();
+        assert_eq!(
+            serde_json::to_value(target.state().unwrap()).unwrap(),
+            expected
+        );
+    }
+}
diff --git a/hypervisor/src/kvm/aarch64/gic/v2_state.rs b/hypervisor/src/kvm/aarch64/gic/v2_state.rs
new file mode 100644
--- /dev/null
+++ b/hypervisor/src/kvm/aarch64/gic/v2_state.rs
@@ -0,0 +1,701 @@
+// SPDX-License-Identifier: Apache-2.0
+
+//! Versioned GICv2 state for fixed vCPU IDs, with deliberately bounded support.
+//!
+//! The caller must quiesce vCPUs and interrupt producers before capture. Restore
+//! requires a fresh initialized target before its first KVM_RUN, with matching
+//! CPU registers and clock restored before resume. KVM's timer load path
+//! recomputes the level of the architectural timer PPIs (27 and 30).
+//!
+//! The v2 ABI does not expose the source of an active SGI, or distinguish a
+//! level IRQ's pending latch from its input line. Active SGIs and pending level
+//! IRQs without a proven source-restoration contract are rejected. This is not
+//! a general live-migration contract; the migration guard remains in place.
+
+use kvm_bindings::{
+    KVM_DEV_ARM_VGIC_GRP_CPU_REGS, KVM_DEV_ARM_VGIC_GRP_DIST_REGS, KVM_DEV_ARM_VGIC_GRP_NR_IRQS,
+    kvm_device_attr,
+};
+use kvm_ioctls::DeviceFd;
+use serde::{Deserialize, Serialize};
+
+use crate::arch::aarch64::gic::{Error, GicVersion, Result, VgicConfig};
+use crate::device::HypervisorDeviceError;
+
+const FORMAT_VERSION: u32 = 1;
+const DIST: u32 = KVM_DEV_ARM_VGIC_GRP_DIST_REGS;
+const CPU: u32 = KVM_DEV_ARM_VGIC_GRP_CPU_REGS;
+const CTLR: u32 = 0;
+const TYPER: u32 = 4;
+const IIDR: u32 = 8;
+const GROUP: u32 = 0x80;
+const ENABLE: u32 = 0x100;
+const CLEAR_ENABLE: u32 = 0x180;
+const PENDING: u32 = 0x200;
+const CLEAR_PENDING: u32 = 0x280;
+const ACTIVE: u32 = 0x300;
+const CLEAR_ACTIVE: u32 = 0x380;
+const PRIORITY: u32 = 0x400;
+const TARGET: u32 = 0x800;
+const CONFIG: u32 = 0xc00;
+const CLEAR_SGI: u32 = 0xf10;
+const SET_SGI: u32 = 0xf20;
+const PMR: u32 = 4;
+const BPR: u32 = 8;
+const ABPR: u32 = 0x1c;
+const APR: u32 = 0xd0;
+const CPU_IIDR: u32 = 0xfc;
+const SGI_MASK: u32 = 0xffff;
+const TIMER_PPIS: u32 = (1 << 27) | (1 << 30);
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Layout {
+    vcpu_count: u64,
+    nr_irqs: u32,
+    dist_addr: u64,
+    dist_size: u64,
+    cpu_addr: u64,
+    cpu_size: u64,
+    msi_addr: u64,
+    msi_size: u64,
+}
+
+impl From<&VgicConfig> for Layout {
+    fn from(config: &VgicConfig) -> Self {
+        Self {
+            vcpu_count: config.vcpu_count,
+            nr_irqs: config.nr_irqs,
+            dist_addr: config.dist_addr,
+            dist_size: config.dist_size,
+            cpu_addr: config.cpu_addr,
+            cpu_size: config.cpu_size,
+            msi_addr: config.msi_addr,
+            msi_size: config.msi_size,
+        }
+    }
+}
+
+/// SPI-only register banks, starting at INTID 32. No guest-supplied offsets.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SpiState {
+    group: Vec<u32>,
+    enabled: Vec<u32>,
+    pending: Vec<u32>,
+    active: Vec<u32>,
+    priority: Vec<u32>,
+    targets: Vec<u32>,
+    config: Vec<u32>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CpuState {
+    id: u32,
+    iidr: u32,
+    ctlr: u32,
+    // Keep KVM's raw five-bit PMR ABI, not the guest's shifted priority value.
+    pmr: u32,
+    bpr: u32,
+    abpr: u32,
+    apr: [u32; 4],
+    group: u32,
+    enabled: u32,
+    pending: u32,
+    active: u32,
+    priority: [u32; 8],
+    // Four SPENDSGIR words encode source masks for all sixteen SGIs.
+    sgi_sources: [u32; 4],
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Gicv2State {
+    format_version: u32,
+    layout: Layout,
+    iidr: u32,
+    typer: u32,
+    ctlr: u32,
+    spis: SpiState,
+    cpus: Vec<CpuState>,
+}
+
+fn invalid(message: impl Into<String>) -> Error {
+    Error::InvalidState(message.into())
+}
+
+trait RegisterAccess {
+    fn read(&self, group: u32, cpu: u32, offset: u32) -> Result<u32>;
+    fn write(&self, group: u32, cpu: u32, offset: u32, value: u32) -> Result<()>;
+}
+
+impl RegisterAccess for DeviceFd {
+    fn read(&self, group: u32, cpu: u32, offset: u32) -> Result<u32> {
+        let mut value = 0_u32;
+        let mut attribute = kvm_device_attr {
+            group,
+            attr: (u64::from(cpu) << 32) | u64::from(offset),
+            addr: &raw mut value as u64,
+            flags: 0,
+        };
+        // SAFETY: The attribute points to a live writable u32, the size used by
+        // the v2 distributor, CPU-interface and NR_IRQS device-attribute ABIs.
+        unsafe { self.get_device_attr(&mut attribute) }.map_err(|error| {
+            Error::GetDeviceAttribute(HypervisorDeviceError::GetDeviceAttribute(error.into()))
+        })?;
+        Ok(value)
+    }
+
+    fn write(&self, group: u32, cpu: u32, offset: u32, value: u32) -> Result<()> {
+        self.set_device_attr(&kvm_device_attr {
+            group,
+            attr: (u64::from(cpu) << 32) | u64::from(offset),
+            addr: &raw const value as u64,
+            flags: 0,
+        })
+        .map_err(|error| {
+            Error::SetDeviceAttribute(HypervisorDeviceError::SetDeviceAttribute(error.into()))
+        })
+    }
+}
+
+fn read_bank(io: &impl RegisterAccess, cpu: u32, base: u32, words: usize) -> Result<Vec<u32>> {
+    (0..words)
+        .map(|word| io.read(DIST, cpu, base + word as u32 * 4))
+        .collect()
+}
+
+fn read_array<const N: usize>(
+    io: &impl RegisterAccess,
+    group: u32,
+    cpu: u32,
+    base: u32,
+) -> Result<[u32; N]> {
+    let mut values = [0; N];
+    for (word, value) in values.iter_mut().enumerate() {
+        *value = io.read(group, cpu, base + word as u32 * 4)?;
+    }
+    Ok(values)
+}
+
+fn validate_config(config: &VgicConfig) -> Result<()> {
+    if config.version != GicVersion::V2
+        || !(1..=8).contains(&config.vcpu_count)
+        || !(64..=1024).contains(&config.nr_irqs)
+        || !config.nr_irqs.is_multiple_of(32)
+    {
+        return Err(invalid("Unsupported GICv2 CPU or interrupt count"));
+    }
+    Ok(())
+}
+
+impl Gicv2State {
+    fn validate(&self, config: &VgicConfig) -> Result<()> {
+        validate_config(config)?;
+        if self.format_version != FORMAT_VERSION || self.layout != Layout::from(config) {
+            return Err(invalid(
+                "Snapshot version or GICv2 layout does not match the target",
+            ));
+        }
+        let expected_typer = (config.nr_irqs / 32 - 1) | ((config.vcpu_count as u32 - 1) << 5);
+        if self.typer != expected_typer || self.ctlr & !1 != 0 {
+            return Err(invalid("Invalid GICv2 distributor TYPER or CTLR"));
+        }
+        if !matches!((self.iidr >> 12) & 0xf, 2 | 3) {
+            return Err(invalid(
+                "GICv2 IIDR revision cannot restore interrupt groups",
+            ));
+        }
+        let spis = (config.nr_irqs - 32) as usize;
+        if self.spis.group.len() != spis / 32
+            || self.spis.enabled.len() != spis / 32
+            || self.spis.pending.len() != spis / 32
+            || self.spis.active.len() != spis / 32
+            || self.spis.priority.len() != spis / 4
+            || self.spis.targets.len() != spis / 4
+            || self.spis.config.len() != spis / 16
+            || self.cpus.len() != config.vcpu_count as usize
+        {
+            return Err(invalid("Invalid GICv2 register-bank length"));
+        }
+        let cpu_mask = (1_u32 << config.vcpu_count) - 1;
+        let byte_mask = cpu_mask * 0x0101_0101;
+        if self
+            .spis
+            .targets
+            .iter()
+            .any(|targets| targets & !byte_mask != 0)
+            || self
+                .spis
+                .priority
+                .iter()
+                .any(|priority| priority & !0xf8f8_f8f8 != 0)
+            || self
+                .spis
+                .config
+                .iter()
+                .any(|config| config & !0xaaaa_aaaa != 0)
+        {
+            return Err(invalid(
+                "Invalid GICv2 SPI target, priority or configuration bits",
+            ));
+        }
+        for spi in 0..spis {
+            let pending = self.spis.pending[spi / 32] & (1 << (spi % 32)) != 0;
+            let edge = self.spis.config[spi / 16] & (2 << ((spi % 16) * 2)) != 0;
+            if pending && !edge {
+                return Err(invalid(format!(
+                    "Pending level SPI {} has no source-line restore contract",
+                    spi + 32
+                )));
+            }
+        }
+        for (index, cpu) in self.cpus.iter().enumerate() {
+            if cpu.id != index as u32
+                || cpu.ctlr & !0x21f != 0
+                || cpu.pmr > 31
+                || cpu.bpr > 7
+                || cpu.abpr > 7
+                || cpu.apr[1..].iter().any(|value| *value != 0)
+                || cpu
+                    .priority
+                    .iter()
+                    .any(|priority| priority & !0xf8f8_f8f8 != 0)
+                || cpu
+                    .sgi_sources
+                    .iter()
+                    .any(|sources| sources & !byte_mask != 0)
+            {
+                return Err(invalid(format!(
+                    "Invalid GICv2 banked state for CPU {index}"
+                )));
+            }
+            if cpu.active & SGI_MASK != 0 {
+                return Err(invalid(format!(
+                    "CPU {index} has active SGIs whose source IDs KVM cannot restore"
+                )));
+            }
+            if cpu.pending & !(SGI_MASK | TIMER_PPIS) != 0 {
+                return Err(invalid(format!(
+                    "CPU {index} has pending level PPIs without a source-line restore contract"
+                )));
+            }
+            let sources_pending = cpu
+                .sgi_sources
+                .iter()
+                .flat_map(|word| word.to_le_bytes())
+                .enumerate()
+                .fold(0_u32, |bits, (sgi, source)| {
+                    bits | (u32::from(source != 0) << sgi)
+                });
+            if cpu.pending & SGI_MASK != sources_pending {
+                return Err(invalid(format!(
+                    "CPU {index} SGI pending bits disagree with their source masks"
+                )));
+            }
+        }
+        Ok(())
+    }
+}
+
+fn capture_registers(io: &impl RegisterAccess, config: &VgicConfig) -> Result<Gicv2State> {
+    validate_config(config)?;
+    if io.read(KVM_DEV_ARM_VGIC_GRP_NR_IRQS, 0, 0)? != config.nr_irqs {
+        return Err(invalid(
+            "Kernel GICv2 interrupt count differs from its configuration",
+        ));
+    }
+    let spis = (config.nr_irqs - 32) as usize;
+    let mut state = Gicv2State {
+        format_version: FORMAT_VERSION,
+        layout: config.into(),
+        iidr: io.read(DIST, 0, IIDR)?,
+        typer: io.read(DIST, 0, TYPER)?,
+        ctlr: io.read(DIST, 0, CTLR)?,
+        spis: SpiState {
+            group: read_bank(io, 0, GROUP + 4, spis / 32)?,
+            enabled: read_bank(io, 0, ENABLE + 4, spis / 32)?,
+            pending: read_bank(io, 0, PENDING + 4, spis / 32)?,
+            active: read_bank(io, 0, ACTIVE + 4, spis / 32)?,
+            priority: read_bank(io, 0, PRIORITY + 32, spis / 4)?,
+            targets: read_bank(io, 0, TARGET + 32, spis / 4)?,
+            config: read_bank(io, 0, CONFIG + 8, spis / 16)?,
+        },
+        cpus: Vec::with_capacity(config.vcpu_count as usize),
+    };
+    for id in 0..config.vcpu_count as u32 {
+        state.cpus.push(CpuState {
+            id,
+            iidr: io.read(CPU, id, CPU_IIDR)?,
+            ctlr: io.read(CPU, id, CTLR)?,
+            pmr: io.read(CPU, id, PMR)?,
+            bpr: io.read(CPU, id, BPR)?,
+            abpr: io.read(CPU, id, ABPR)?,
+            apr: read_array(io, CPU, id, APR)?,
+            group: io.read(DIST, id, GROUP)?,
+            enabled: io.read(DIST, id, ENABLE)?,
+            pending: io.read(DIST, id, PENDING)?,
+            active: io.read(DIST, id, ACTIVE)?,
+            priority: read_array(io, DIST, id, PRIORITY)?,
+            sgi_sources: read_array(io, DIST, id, SET_SGI)?,
+        });
+    }
+    state.validate(config)?;
+    Ok(state)
+}
+
+pub(super) fn capture(device: &DeviceFd, config: &VgicConfig) -> Result<Gicv2State> {
+    capture_registers(device, config)
+}
+
+fn write_bank(io: &impl RegisterAccess, cpu: u32, base: u32, values: &[u32]) -> Result<()> {
+    for (word, value) in values.iter().enumerate() {
+        io.write(DIST, cpu, base + word as u32 * 4, *value)?;
+    }
+    Ok(())
+}
+
+fn replace_bits(
+    io: &impl RegisterAccess,
+    cpu: u32,
+    set: u32,
+    clear: u32,
+    values: &[u32],
+) -> Result<()> {
+    for (word, value) in values.iter().enumerate() {
+        let offset = word as u32 * 4;
+        io.write(DIST, cpu, clear + offset, u32::MAX)?;
+        io.write(DIST, cpu, set + offset, *value)?;
+    }
+    Ok(())
+}
+
+fn restore_registers(
+    io: &impl RegisterAccess,
+    config: &VgicConfig,
+    state: &Gicv2State,
+) -> Result<()> {
+    state.validate(config)?;
+    // Complete structural and compatibility validation before the first write.
+    if io.read(KVM_DEV_ARM_VGIC_GRP_NR_IRQS, 0, 0)? != config.nr_irqs
+        || io.read(DIST, 0, TYPER)? != state.typer
+        || io.read(DIST, 0, IIDR)? != state.iidr
+    {
+        return Err(invalid(
+            "Target GICv2 IRQ count, TYPER or IIDR is incompatible",
+        ));
+    }
+    for cpu in &state.cpus {
+        if io.read(CPU, cpu.id, CPU_IIDR)? != cpu.iidr {
+            return Err(invalid(format!(
+                "CPU {} interface IIDR is incompatible",
+                cpu.id
+            )));
+        }
+    }
+
+    // IIDR must be the first write: it enables userspace IGROUPR restoration.
+    io.write(DIST, 0, IIDR, state.iidr)?;
+    io.write(DIST, 0, CTLR, 0)?;
+    for cpu in &state.cpus {
+        io.write(CPU, cpu.id, CTLR, 0)?;
+    }
+
+    write_bank(io, 0, GROUP + 4, &state.spis.group)?;
+    write_bank(io, 0, TARGET + 32, &state.spis.targets)?;
+    write_bank(io, 0, CONFIG + 8, &state.spis.config)?;
+    write_bank(io, 0, PRIORITY + 32, &state.spis.priority)?;
+    replace_bits(io, 0, ENABLE + 4, CLEAR_ENABLE + 4, &state.spis.enabled)?;
+    replace_bits(io, 0, ACTIVE + 4, CLEAR_ACTIVE + 4, &state.spis.active)?;
+    replace_bits(io, 0, PENDING + 4, CLEAR_PENDING + 4, &state.spis.pending)?;
+    for cpu in &state.cpus {
+        io.write(DIST, cpu.id, GROUP, cpu.group)?;
+        write_bank(io, cpu.id, PRIORITY, &cpu.priority)?;
+        replace_bits(io, cpu.id, ENABLE, CLEAR_ENABLE, &[cpu.enabled])?;
+        replace_bits(io, cpu.id, ACTIVE, CLEAR_ACTIVE, &[cpu.active])?;
+        // Generic ISPENDR0 would invent the destination CPU as an SGI source.
+        io.write(DIST, cpu.id, CLEAR_PENDING, !SGI_MASK)?;
+        io.write(DIST, cpu.id, PENDING, cpu.pending & !SGI_MASK)?;
+        replace_bits(io, cpu.id, SET_SGI, CLEAR_SGI, &cpu.sgi_sources)?;
+        io.write(CPU, cpu.id, PMR, cpu.pmr)?;
+        io.write(CPU, cpu.id, BPR, cpu.bpr)?;
+        io.write(CPU, cpu.id, ABPR, cpu.abpr)?;
+        for (word, value) in cpu.apr.iter().enumerate() {
+            io.write(CPU, cpu.id, APR + word as u32 * 4, *value)?;
+        }
+        io.write(CPU, cpu.id, CTLR, cpu.ctlr)?;
+    }
+    io.write(DIST, 0, CTLR, state.ctlr)
+}
+
+pub(super) fn restore(device: &DeviceFd, config: &VgicConfig, state: &Gicv2State) -> Result<()> {
+    restore_registers(device, config, state)
