diff --git a/hypervisor/src/kvm/aarch64/gic/v2.rs b/hypervisor/src/kvm/aarch64/gic/v2.rs
new file mode 100644
--- /dev/null
+++ b/hypervisor/src/kvm/aarch64/gic/v2.rs
@@ -0,0 +1,404 @@
+// SPDX-License-Identifier: Apache-2.0
+
+use std::any::Any;
+
+use kvm_ioctls::DeviceFd;
+
+use super::v2_state;
+use crate::CpuState;
+use crate::arch::aarch64::gic::{
+    Error, GIC_V2M_COMPATIBLE, GICV2M_SPI_BASE, GICV2M_SPI_NUM, GicState, GicVersion, Result, Vgic,
+    VgicConfig,
+};
+use crate::device::HypervisorDeviceError;
+use crate::kvm::KvmVm;
+
+/// KVM's GICv2 model uses a banked MMIO CPU interface and supports at most eight CPUs.
+pub struct KvmGicV2 {
+    device: DeviceFd,
+    config: VgicConfig,
+}
+
+impl KvmGicV2 {
+    fn validate_config(config: &VgicConfig) -> Result<()> {
+        if config.version != GicVersion::V2 {
+            return Err(Error::InvalidConfiguration("GICv2 requires the v2 layout"));
+        }
+        if !(1..=8).contains(&config.vcpu_count) {
+            return Err(Error::InvalidConfiguration("GICv2 requires 1 to 8 vCPUs"));
+        }
+        if config.dist_size != 0x1000 || config.cpu_size != 0x2000 {
+            return Err(Error::InvalidConfiguration("Invalid GICv2 MMIO sizes"));
+        }
+        if config.dist_addr & 0xfff != 0 || config.cpu_addr & 0xfff != 0 {
+            return Err(Error::InvalidConfiguration("Unaligned GICv2 MMIO address"));
+        }
+        let dist_end = config.dist_addr.checked_add(config.dist_size);
+        let cpu_end = config.cpu_addr.checked_add(config.cpu_size);
+        match (dist_end, cpu_end) {
+            (Some(dist_end), Some(cpu_end))
+                if dist_end <= config.cpu_addr || cpu_end <= config.dist_addr => {}
+            _ => return Err(Error::InvalidConfiguration("Invalid GICv2 MMIO ranges")),
+        }
+        if !(64..=1024).contains(&config.nr_irqs) || config.nr_irqs % 32 != 0 {
+            return Err(Error::InvalidConfiguration("Invalid GICv2 interrupt count"));
+        }
+        if config.msi_size != 0 {
+            let msi_end = config
+                .msi_addr
+                .checked_add(config.msi_size)
+                .ok_or(Error::InvalidConfiguration("Invalid GICv2m MMIO range"))?;
+            if config.msi_size != 0x1000
+                || config.msi_addr & 0xfff != 0
+                || config.nr_irqs < GICV2M_SPI_BASE + GICV2M_SPI_NUM
+            {
+                return Err(Error::InvalidConfiguration("Invalid GICv2m configuration"));
+            }
+            for (start, size) in [
+                (config.dist_addr, config.dist_size),
+                (config.cpu_addr, config.cpu_size),
+            ] {
+                if config.msi_addr < start + size && msi_end > start {
+                    return Err(Error::InvalidConfiguration("Overlapping GICv2m MMIO range"));
+                }
+            }
+        } else if config.msi_addr != 0 {
+            return Err(Error::InvalidConfiguration(
+                "GICv2m address requires a frame size",
+            ));
+        }
+        Ok(())
+    }
+
+    pub fn new(vm: &KvmVm, config: &VgicConfig) -> Result<Self> {
+        Self::validate_config(config)?;
+        let mut request = kvm_bindings::kvm_create_device {
+            type_: kvm_bindings::kvm_device_type_KVM_DEV_TYPE_ARM_VGIC_V2,
+            fd: 0,
+            flags: 0,
+        };
+        let device = vm
+            .fd
+            .create_device(&mut request)
+            .map_err(|e| Error::CreateGic(crate::HypervisorVmError::CreateDevice(e.into())))?;
+        let gic = Self {
+            device,
+            config: config.clone(),
+        };
+        gic.set_attr(
+            kvm_bindings::KVM_DEV_ARM_VGIC_GRP_ADDR,
+            kvm_bindings::KVM_VGIC_V2_ADDR_TYPE_DIST.into(),
+            &raw const config.dist_addr as u64,
+        )?;
+        gic.set_attr(
+            kvm_bindings::KVM_DEV_ARM_VGIC_GRP_ADDR,
+            kvm_bindings::KVM_VGIC_V2_ADDR_TYPE_CPU.into(),
+            &raw const config.cpu_addr as u64,
+        )?;
+        gic.set_attr(
+            kvm_bindings::KVM_DEV_ARM_VGIC_GRP_NR_IRQS,
+            0,
+            &raw const config.nr_irqs as u64,
+        )?;
+        // All fixed vCPUs have been created before the interrupt controller.
+        gic.set_attr(
+            kvm_bindings::KVM_DEV_ARM_VGIC_GRP_CTRL,
+            kvm_bindings::KVM_DEV_ARM_VGIC_CTRL_INIT.into(),
+            0,
+        )?;
+        Ok(gic)
+    }
+
+    fn set_attr(&self, group: u32, attr: u64, addr: u64) -> Result<()> {
+        self.device
+            .set_device_attr(&kvm_bindings::kvm_device_attr {
+                group,
+                attr,
+                addr,
+                flags: 0,
+            })
+            .map_err(|e| {
+                Error::SetDeviceAttribute(HypervisorDeviceError::SetDeviceAttribute(e.into()))
+            })
+    }
+}
+
+impl Vgic for KvmGicV2 {
+    fn version(&self) -> GicVersion {
+        GicVersion::V2
+    }
+
+    fn fdt_compatibility(&self) -> &str {
+        // The pinned Cloud Hypervisor EDK2 firmware discovers this binding.
+        "arm,cortex-a15-gic"
+    }
+
+    fn fdt_maint_irq(&self) -> u32 {
+        9
+    }
+
+    fn device_properties(&self) -> [u64; 4] {
+        [
+            self.config.dist_addr,
+            self.config.dist_size,
+            self.config.cpu_addr,
+            self.config.cpu_size,
+        ]
+    }
+
+    fn vcpu_count(&self) -> u64 {
+        self.config.vcpu_count
+    }
+
+    fn msi_compatible(&self) -> bool {
+        self.config.msi_size != 0
+    }
+
+    fn msi_compatibility(&self) -> &str {
+        GIC_V2M_COMPATIBLE
+    }
+
+    fn msi_properties(&self) -> [u64; 2] {
+        [self.config.msi_addr, self.config.msi_size]
+    }
+
+    fn set_gicr_typers(&mut self, _vcpu_states: &[CpuState]) {}
+
+    fn as_any_concrete_mut(&mut self) -> &mut dyn Any {
+        self
+    }
+
+    fn state(&self) -> Result<GicState> {
+        v2_state::capture(&self.device, &self.config).map(GicState::KvmV2)
+    }
+
+    fn set_state(&mut self, state: &GicState) -> Result<()> {
+        let GicState::KvmV2(state) = state else {
+            return Err(Error::InvalidState("Expected a GICv2 snapshot".into()));
+        };
+        v2_state::restore(&self.device, &self.config, state)
+    }
+
+    fn save_data_tables(&self) -> Result<()> {
+        // GICv2 has no ITS or redistributor tables in guest RAM.
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
