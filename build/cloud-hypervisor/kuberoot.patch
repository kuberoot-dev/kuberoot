+#[cfg(target_arch = "aarch64")]
+fn append_gic_madt_entries(
+    madt: &mut Sdt,
+    mpidrs: &[u64],
+    version: GicVersion,
+    registers: [u64; 4],
+    msi: Option<(&str, [u64; 2])>,
+    hotplug_boot_vcpus: Option<u32>,
