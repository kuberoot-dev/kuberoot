+
+#[cfg(test)]
+mod tests {
+    use std::cell::RefCell;
+    use std::collections::HashMap;
+
+    use super::*;
+    use crate::arch::aarch64::gic::GicState;
+    use crate::kvm::aarch64::gic::Gicv3ItsState;
+
+    fn config() -> VgicConfig {
+        VgicConfig {
+            version: GicVersion::V2,
+            vcpu_count: 2,
+            nr_irqs: 256,
+            dist_addr: 0x08ff_f000,
+            dist_size: 0x1000,
+            cpu_addr: 0x08ff_d000,
+            cpu_size: 0x2000,
+            redists_addr: 0,
+            redists_size: 0,
+            msi_addr: 0x08ff_c000,
+            msi_size: 0x1000,
+        }
+    }
+
+    type Register = (u32, u32, u32);
+    type Write = (u32, u32, u32, u32);
+
+    // Model the set/clear aliases and SGI source side effects independently of
+    // the serializer. Ordinary assignment would miss stale-bit restoration bugs.
+    struct Registers {
+        values: RefCell<HashMap<Register, u32>>,
+        writes: RefCell<Vec<Write>>,
+    }
+
+    impl Registers {
+        fn new(config: &VgicConfig) -> Self {
+            let mut values = HashMap::from([
+                ((KVM_DEV_ARM_VGIC_GRP_NR_IRQS, 0, 0), config.nr_irqs),
+                ((DIST, 0, IIDR), 0x0200_343b),
+                (
+                    (DIST, 0, TYPER),
+                    config.nr_irqs / 32 - 1 | ((config.vcpu_count as u32 - 1) << 5),
+                ),
+            ]);
+            for cpu in 0..config.vcpu_count as u32 {
+                values.insert((CPU, cpu, CPU_IIDR), 0x0042_043b);
+            }
+            Self {
+                values: RefCell::new(values),
+                writes: RefCell::new(Vec::new()),
+            }
+        }
+
+        fn fixture() -> Self {
+            let io = Self::new(&config());
+            io.write(DIST, 0, CTLR, 1).unwrap();
+            io.write(DIST, 0, CONFIG + 0x20, 0xa).unwrap(); // SPIs 128/129: edge
+            io.write(DIST, 0, TARGET + 128, 0x0102).unwrap();
+            io.write(DIST, 0, PRIORITY + 128, 0x2010).unwrap();
+            io.write(DIST, 0, GROUP + 0x10, 3).unwrap();
+            io.write(DIST, 0, ENABLE + 0x10, 3).unwrap();
+            io.write(DIST, 0, PENDING + 0x10, 1).unwrap();
+            io.write(DIST, 0, ACTIVE + 0x10, 2).unwrap();
+            for cpu in 0..2 {
+                io.write(CPU, cpu, CTLR, 0x201).unwrap();
+                io.write(CPU, cpu, PMR, 31 - cpu).unwrap();
+                io.write(CPU, cpu, BPR, cpu).unwrap();
+                io.write(CPU, cpu, ABPR, cpu + 1).unwrap();
+                io.write(CPU, cpu, APR, 1 << (cpu + 2)).unwrap();
+                io.write(DIST, cpu, GROUP, TIMER_PPIS).unwrap();
+                io.write(DIST, cpu, ENABLE, TIMER_PPIS | SGI_MASK).unwrap();
+                io.write(DIST, cpu, PRIORITY + 16, 0x3020_1000).unwrap();
+            }
+            // CPU0's SGI5 was sent by CPU1; CPU1's SGI7 was sent by CPU0.
+            io.write(DIST, 0, SET_SGI + 4, 2 << 8).unwrap();
+            io.write(DIST, 1, SET_SGI + 4, 1 << 24).unwrap();
+            io.write(DIST, 0, PENDING, TIMER_PPIS).unwrap();
+            io.write(DIST, 0, ACTIVE, 1 << 27).unwrap();
+            io.writes.borrow_mut().clear();
+            io
+        }
+    }
+
+    impl RegisterAccess for Registers {
+        fn read(&self, group: u32, cpu: u32, offset: u32) -> Result<u32> {
+            Ok(*self
+                .values
+                .borrow()
+                .get(&(group, cpu, offset))
+                .unwrap_or(&0))
+        }
+
+        fn write(&self, group: u32, cpu: u32, offset: u32, value: u32) -> Result<()> {
+            self.writes.borrow_mut().push((group, cpu, offset, value));
+            let mut values = self.values.borrow_mut();
+            let (register, set, clear) = if group == DIST {
+                match offset {
+                    0x100..0x180 | 0x200..0x280 | 0x300..0x380 => (offset, true, false),
+                    0x180..0x200 | 0x280..0x300 | 0x380..0x400 => (offset - 0x80, false, true),
+                    0xf10..0xf20 => (offset + 0x10, false, true),
+                    0xf20..0xf30 => (offset, true, false),
+                    _ => (offset, false, false),
+                }
+            } else {
+                (offset, false, false)
+            };
+            let old = values.entry((group, cpu, register)).or_default();
+            *old = if set {
+                *old | value
+            } else if clear {
+                *old & !value
+            } else {
+                value
+            };
+            if group == DIST && (0xf10..0xf30).contains(&offset) {
+                let mut pending = 0_u32;
+                for sgi in 0..16 {
+                    let word = values
+                        .get(&(DIST, cpu, SET_SGI + sgi / 4 * 4))
+                        .copied()
+                        .unwrap_or(0);
+                    if word >> (sgi % 4 * 8) & 0xff != 0 {
+                        pending |= 1 << sgi;
+                    }
+                }
+                let bits = values.entry((DIST, cpu, PENDING)).or_default();
+                *bits = (*bits & !SGI_MASK) | pending;
+            }
+            // Model the KVM-specific ISPENDR0 SGI source invention.
+            if group == DIST && offset == PENDING {
+                for sgi in 0..16 {
+                    if value & (1 << sgi) != 0 {
+                        *values
+                            .entry((DIST, cpu, SET_SGI + sgi / 4 * 4))
+                            .or_default() |= (1 << cpu) << (sgi % 4 * 8);
+                    }
+                }
+            }
+            Ok(())
+        }
+    }
+
+    #[test]
+    fn test_v2_state_roundtrip_restores_exact_banks_and_sgi_sources() {
+        let source = Registers::fixture();
+        let state = capture_registers(&source, &config()).unwrap();
+        let target = Registers::new(&config());
+        // Deliberately dirty writable state: restore must clear old set bits.
+        target.write(DIST, 0, ENABLE + 0x10, u32::MAX).unwrap();
+        target.write(DIST, 0, PENDING + 0x10, u32::MAX).unwrap();
+        target.write(DIST, 0, ACTIVE + 0x10, u32::MAX).unwrap();
+        target.write(DIST, 0, SET_SGI + 4, 0x0303_0303).unwrap();
+        target.write(DIST, 1, SET_SGI + 4, 0x0303_0303).unwrap();
+        target.writes.borrow_mut().clear();
+
+        restore_registers(&target, &config(), &state).unwrap();
+        assert_eq!(capture_registers(&target, &config()).unwrap(), state);
+        let writes = target.writes.borrow();
+        assert_eq!(writes.first(), Some(&(DIST, 0, IIDR, state.iidr)));
+        assert_eq!(writes.last(), Some(&(DIST, 0, CTLR, state.ctlr)));
+        assert!(
+            writes
+                .iter()
+                .filter(|(group, _, offset, _)| *group == DIST && *offset == PENDING)
+                .all(|(_, _, _, value)| value & SGI_MASK == 0)
+        );
+        assert_eq!(target.read(DIST, 0, SET_SGI + 4).unwrap(), 2 << 8);
+        assert_eq!(target.read(DIST, 1, SET_SGI + 4).unwrap(), 1 << 24);
+        assert!(
+            source.writes.borrow().is_empty(),
+            "capture must not mutate the source"
+        );
+    }
+
+    #[test]
+    fn test_v2_state_invalid_payload_never_mutates_target() {
+        let valid = capture_registers(&Registers::fixture(), &config()).unwrap();
+        let mut invalid_states = Vec::new();
+        macro_rules! invalid_case {
+            ($state:ident, $change:expr) => {{
+                let mut $state = valid.clone();
+                $change;
+                invalid_states.push($state);
+            }};
+        }
+        invalid_case!(s, s.format_version = 2);
+        invalid_case!(s, s.layout.nr_irqs = 128);
+        invalid_case!(s, s.layout.cpu_addr += 0x1000);
+        invalid_case!(s, s.spis.pending.pop());
+        invalid_case!(s, s.cpus.pop());
+        invalid_case!(s, s.cpus[1].id = 0);
+        invalid_case!(s, s.cpus[0].pmr = 32);
+        invalid_case!(s, s.cpus[0].sgi_sources[0] = 4);
+        invalid_case!(s, s.cpus[0].pending ^= 1);
+        invalid_case!(s, s.spis.targets[0] = 4);
+        invalid_case!(s, s.spis.config[0] = 1);
+        invalid_case!(s, s.iidr ^= 1);
+        invalid_case!(s, s.iidr &= !0xf000);
+        invalid_case!(s, s.cpus[1].iidr ^= 1);
+        for state in invalid_states {
+            let target = Registers::new(&config());
+            assert!(restore_registers(&target, &config(), &state).is_err());
+            assert!(target.writes.borrow().is_empty());
+        }
+    }
+
+    #[test]
+    fn test_v2_state_active_sgi_and_unknown_level_sources_are_rejected() {
+        for (offset, value, expected) in [
+            (ACTIVE, 1, "active SGIs"),
+            (PENDING, 1 << 23, "pending level PPIs"),
+            (PENDING + 4, 1 << 8, "Pending level SPI 40"),
+        ] {
+            let io = Registers::fixture();
+            io.write(DIST, 0, offset, value).unwrap();
+            io.writes.borrow_mut().clear();
+            let error = capture_registers(&io, &config()).unwrap_err();
+            assert!(error.to_string().contains(expected), "{error}");
+            assert!(io.writes.borrow().is_empty());
+        }
+        let valid = capture_registers(&Registers::fixture(), &config()).unwrap();
+        for (active, pending) in [(1, valid.cpus[0].pending), (0, 1 << 23)] {
+            let mut state = valid.clone();
+            state.cpus[0].active = active;
+            state.cpus[0].pending = pending;
+            let target = Registers::new(&config());
+            assert!(restore_registers(&target, &config(), &state).is_err());
+            assert!(target.writes.borrow().is_empty());
+        }
+    }
+
+    #[test]
+    fn test_v2_state_active_level_without_pending_is_preserved() {
+        let source = Registers::fixture();
+        source.write(DIST, 0, ACTIVE + 4, 1 << 8).unwrap(); // level SPI40, input low
+        let state = capture_registers(&source, &config()).unwrap();
+        let target = Registers::new(&config());
+        restore_registers(&target, &config(), &state).unwrap();
+        assert_eq!(target.read(DIST, 0, ACTIVE + 4).unwrap(), 1 << 8);
+        assert_eq!(target.read(DIST, 0, PENDING + 4).unwrap(), 0);
+    }
+
+    #[test]
+    fn test_v2_state_serde_preserves_legacy_v3_encoding() {
+        let state = capture_registers(&Registers::fixture(), &config()).unwrap();
+        let value = serde_json::to_value(GicState::KvmV2(state.clone())).unwrap();
+        assert_eq!(value["KvmV2"]["format_version"], 1);
+        let decoded: GicState = serde_json::from_value(value).unwrap();
+        let GicState::KvmV2(decoded) = decoded else {
+            panic!("Lost GICv2 state tag")
+        };
+        assert_eq!(decoded, state);
+
+        let legacy = Gicv3ItsState::default();
+        let raw = serde_json::to_value(&legacy).unwrap();
+        let tagged = serde_json::to_value(GicState::Kvm(legacy)).unwrap();
+        assert_eq!(tagged, serde_json::json!({"Kvm": raw.clone()}));
+        for value in [raw, tagged] {
+            assert!(matches!(
+                serde_json::from_value::<GicState>(value).unwrap(),
+                GicState::Kvm(_)
+            ));
+        }
+    }
+}
