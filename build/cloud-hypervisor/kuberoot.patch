+// The caller holds both the individual route lock and the shared routing-table
+// lock. A failed table update must not leave a rejected entry in the cache:
+// otherwise it also prevents unrelated interrupt groups from being updated.
+fn update_routing_entry(
+    routes: &mut HashMap<u32, RoutingEntry>,
+    gsi: u32,
+    entry: RoutingEntry,
+    set_gsi: bool,
+    was_registered: bool,
+    mut set_registered: impl FnMut(bool) -> Result<()>,
+    apply_routes: impl FnOnce(&HashMap<u32, RoutingEntry>) -> Result<()>,
+) -> Result<()> {
+    let masked = entry.masked;
+    // Deassign IRQFD before removing its route from the kernel table (#3827).
+    if masked {
+        set_registered(false)?;
+    }
+
+    let old_entry = routes.insert(gsi, entry);
+    if set_gsi && let Err(error) = apply_routes(routes) {
+        // The failed ioctl leaves the old kernel table installed. Restore its
+        // cached counterpart before allowing any other group to update it.
+        if let Some(old_entry) = old_entry {
+            routes.insert(gsi, old_entry);
+        } else {
+            routes.remove(&gsi);
+        }
+        if masked
+            && was_registered
+            && let Err(restore_error) = set_registered(true)
+        {
+            return Err(io::Error::new(
+                error.kind(),
+                format!("{error}; failed restoring IRQFD registration: {restore_error}"),
+            ));
+        }
+        return Err(error);
+    }
+
+    // Assign IRQFD only after its route has been installed in the kernel.
+    if !masked {
+        set_registered(true)?;
+    }
+    Ok(())
