+        let mut offset = 44;
+        while offset < bytes.len() {
+            let length = bytes[offset + 1] as usize;
+            assert!(length >= 2 && offset + length <= bytes.len());
+            records.push(&bytes[offset..offset + length]);
+            offset += length;
+        }
+        records
+    }
