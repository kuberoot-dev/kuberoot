@@ -0,0 +1,268 @@
+// SPDX-License-Identifier: Apache-2.0
+
+//! A non-secure GICv2m MSI frame, following Arm BSA DEN0094A, Appendix I.
+//!
+//! The frame has no writable register state. Its immutable SPI range must be
+//! recreated from the machine configuration; pending interrupts belong to the
+//! GIC and interrupt routing. This device alone does not provide migration.
+
+use std::io;
+use std::ops::Range;
+use std::sync::{Arc, Barrier};
+
+use log::error;
+use vm_device::BusDevice;
+use vm_device::interrupt::InterruptSourceGroup;
+
+pub const GICV2M_FRAME_SIZE: u64 = 0x1000;
+pub const MSI_SETSPI_NS: u64 = 0x040;
+
+const MSI_TYPER: u64 = 0x008;
+const MSI_IIDR: u64 = 0xfcc;
+const SPI_ID_MASK: u32 = 0x3ff;
+const SPI_LIMIT: u32 = 1020;
+
+/// A GICv2m frame backed by an IRQ group indexed by absolute SPI INTIDs.
+pub struct GicV2m {
+    interrupts: Arc<dyn InterruptSourceGroup>,
+    spis: Range<u32>,
+}
+
+impl GicV2m {
+    /// The caller must route every absolute SPI in the range to the GIC.
+    /// Group indices are not relative to `spi_base`. The guest MSI driver
+    /// programs these GIC SPIs as edge-triggered interrupts.
+    pub fn new(
+        interrupts: Arc<dyn InterruptSourceGroup>,
+        spi_base: u32,
+        spi_count: u32,
+    ) -> io::Result<Self> {
+        let end = spi_base.checked_add(spi_count);
+        if spi_base < 32 || spi_count == 0 || end.is_none_or(|end| end > SPI_LIMIT) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                format!("Invalid GICv2m SPI range: base={spi_base}, count={spi_count}"),
+            ));
+        }
+        Ok(Self {
+            interrupts,
+            spis: spi_base..end.unwrap(),
+        })
+    }
+}
+
+impl BusDevice for GicV2m {
+    fn read(&mut self, _base: u64, offset: u64, data: &mut [u8]) {
+        // Only aligned word reads are implemented; other reads return zero.
+        data.fill(0);
+        if data.len() != size_of::<u32>()
+            || offset >= GICV2M_FRAME_SIZE
+            || !offset.is_multiple_of(4)
+        {
+            return;
+        }
+        let value = match offset {
+            MSI_TYPER => (self.spis.start << 16) | (self.spis.end - self.spis.start),
+            // Architecture revision zero, with no vendor-specific identifier
+            // or erratum that changes the MSI data's absolute INTID encoding.
+            MSI_IIDR => 0,
+            _ => 0,
+        };
+        data.copy_from_slice(&value.to_le_bytes());
+    }
+
+    fn write(&mut self, _base: u64, offset: u64, data: &[u8]) -> Option<Arc<Barrier>> {
+        if offset != MSI_SETSPI_NS {
+            return None;
+        }
+        // BSA I.9 requires both word writes and halfword writes to bits [15:0].
+        let value = match data {
+            [low, high] => u32::from(u16::from_le_bytes([*low, *high])),
+            [a, b, c, d] => u32::from_le_bytes([*a, *b, *c, *d]),
+            _ => return None,
+        };
+        // Bits [31:10] are reserved. Only the ten-bit SPI field selects an IRQ.
+        let spi = value & SPI_ID_MASK;
+        if self.spis.contains(&spi)
+            && let Err(err) = self.interrupts.trigger(spi)
+        {
+            error!("Failed triggering GICv2m SPI {spi}: {err}");
+        }
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::Mutex;
+    use std::sync::atomic::{AtomicBool, Ordering};
+
+    use vm_device::interrupt::{InterruptIndex, InterruptSourceConfig};
+    use vmm_sys_util::eventfd::EventFd;
+
+    use super::*;
+
+    #[derive(Default)]
+    struct RecordingInterrupts {
+        triggered: Mutex<Vec<InterruptIndex>>,
+        fail: AtomicBool,
+    }
+
+    impl InterruptSourceGroup for RecordingInterrupts {
+        fn trigger(&self, index: InterruptIndex) -> io::Result<()> {
+            self.triggered.lock().unwrap().push(index);
+            if self.fail.load(Ordering::Relaxed) {
+                return Err(io::Error::other("Injected IRQ failure"));
+            }
+            Ok(())
+        }
+
+        fn notifier(&self, _index: InterruptIndex) -> Option<EventFd> {
+            None
+        }
+
+        fn update(
+            &self,
+            _index: InterruptIndex,
+            _config: InterruptSourceConfig,
+            _masked: bool,
+            _set_gsi: bool,
+        ) -> io::Result<()> {
+            Err(io::Error::new(io::ErrorKind::Unsupported, "Test IRQ group"))
+        }
+
+        fn set_gsi(&self) -> io::Result<()> {
+            Err(io::Error::new(io::ErrorKind::Unsupported, "Test IRQ group"))
+        }
+    }
+
+    fn frame() -> (GicV2m, Arc<RecordingInterrupts>) {
+        let interrupts = Arc::new(RecordingInterrupts::default());
+        let frame = GicV2m::new(interrupts.clone(), 128, 64).unwrap();
+        (frame, interrupts)
+    }
+
+    #[test]
+    fn test_gicv2m_registers_and_immutable_configuration() {
+        let (mut frame, interrupts) = frame();
+        for (offset, expected) in [
+            (MSI_TYPER, 0x0080_0040_u32),
+            (MSI_IIDR, 0),
+            (MSI_SETSPI_NS, 0),
+        ] {
+            let mut data = [0xff; 4];
+            frame.read(0x08ff_c000, offset, &mut data);
+            assert_eq!(u32::from_le_bytes(data), expected);
+        }
+        for offset in [MSI_TYPER, MSI_IIDR, 0, 0xffc] {
+            frame.write(0x08ff_c000, offset, &u32::MAX.to_le_bytes());
+        }
+        let mut data = [0; 4];
+        frame.read(0x08ff_c000, MSI_TYPER, &mut data);
+        assert_eq!(u32::from_le_bytes(data), 0x0080_0040);
+        assert!(interrupts.triggered.lock().unwrap().is_empty());
+    }
+
+    #[test]
+    fn test_gicv2m_word_and_halfword_trigger_absolute_spi() {
+        let (mut frame, interrupts) = frame();
+        for spi in 128_u32..192 {
+            frame.write(0x08ff_c000, MSI_SETSPI_NS, &spi.to_le_bytes());
+            frame.write(0x08ff_c000, MSI_SETSPI_NS, &(spi as u16).to_le_bytes());
+        }
+        let expected: Vec<u32> = (128..192).flat_map(|spi| [spi, spi]).collect();
+        assert_eq!(*interrupts.triggered.lock().unwrap(), expected);
+    }
+
+    #[test]
+    fn test_gicv2m_invalid_accesses_do_not_trigger() {
+        let (mut frame, interrupts) = frame();
+        for offset in [
+            0,
+            MSI_TYPER,
+            MSI_SETSPI_NS - 1,
+            MSI_SETSPI_NS + 1,
+            MSI_SETSPI_NS + 2,
+            MSI_IIDR,
+            0xfff,
+            GICV2M_FRAME_SIZE,
+            u64::MAX,
+        ] {
+            frame.write(0x08ff_c000, offset, &128_u32.to_le_bytes());
+        }
+        for width in [0, 1, 3, 5, 8] {
+            let mut data = vec![0; width];
+            if let Some(low) = data.first_mut() {
+                *low = 128;
+            }
+            frame.write(0x08ff_c000, MSI_SETSPI_NS, &data);
+        }
+        for spi in [0_u32, 31, 32, 127, 192, 1019, 1020, 1023] {
+            frame.write(0x08ff_c000, MSI_SETSPI_NS, &spi.to_le_bytes());
+        }
+        assert!(interrupts.triggered.lock().unwrap().is_empty());
+    }
+
+    #[test]
+    fn test_gicv2m_reserved_bits_do_not_change_spi_field() {
+        let (mut frame, interrupts) = frame();
+        frame.write(0, MSI_SETSPI_NS, &0xffff_fc80_u32.to_le_bytes());
+        frame.write(0, MSI_SETSPI_NS, &0xfc81_u16.to_le_bytes());
+        frame.write(0, MSI_SETSPI_NS, &u32::MAX.to_le_bytes());
+        assert_eq!(*interrupts.triggered.lock().unwrap(), vec![128, 129]);
+    }
+
+    #[test]
+    fn test_gicv2m_invalid_reads_return_zero() {
+        let (mut frame, _) = frame();
+        for offset in [
+            0,
+            MSI_TYPER + 1,
+            MSI_TYPER + 2,
+            MSI_SETSPI_NS,
+            0xffc,
+            GICV2M_FRAME_SIZE,
+            u64::MAX,
+        ] {
+            let mut data = [0xff; 4];
+            frame.read(0, offset, &mut data);
+            assert_eq!(data, [0; 4]);
+        }
+        for width in [0, 1, 2, 3, 5, 8] {
+            let mut data = vec![0xff; width];
+            frame.read(0, MSI_TYPER, &mut data);
+            assert_eq!(data, vec![0; width]);
+        }
+    }
+
+    #[test]
+    fn test_gicv2m_rejects_invalid_spi_ranges() {
+        let interrupts = Arc::new(RecordingInterrupts::default());
+        for (base, count) in [
+            (0, 64),
+            (31, 1),
+            (128, 0),
+            (1020, 1),
+            (1019, 2),
+            (u32::MAX, 2),
+            (128, u32::MAX),
+        ] {
+            assert!(GicV2m::new(interrupts.clone(), base, count).is_err());
+        }
+        for (base, count) in [(32, 1), (128, 64), (1019, 1)] {
+            assert!(GicV2m::new(interrupts.clone(), base, count).is_ok());
+        }
+    }
+
+    #[test]
+    fn test_gicv2m_irq_failure_does_not_panic_or_retry() {
+        let (mut frame, interrupts) = frame();
+        interrupts.fail.store(true, Ordering::Relaxed);
+        assert!(
+            frame
+                .write(0, MSI_SETSPI_NS, &128_u32.to_le_bytes())
+                .is_none()
+        );
+        assert_eq!(*interrupts.triggered.lock().unwrap(), vec![128]);
+    }
+}
