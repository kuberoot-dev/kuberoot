+    use arch::layout::{GIC_V2M_COMPATIBLE, GICV2M_SPI_BASE, GICV2M_SPI_NUM};
+
+    use crate::acpi;
+
+    // GICv2 exposes a memory-mapped CPU interface; GICv3 uses system registers.
+    let cpu_interface_address = match version {
+        GicVersion::V2 => registers[2],
+        GicVersion::V3 => 0,
+    };
+    for (cpu, mpidr) in mpidrs.iter().enumerate() {
+        // ACPI retains only MPIDR affinity fields Aff3:Aff0.
+        madt.append(GicC {
+            r#type: acpi::ACPI_APIC_GENERIC_CPU_INTERFACE,
+            length: 80,
+            reserved0: 0,
+            cpu_interface_number: cpu as u32,
+            uid: cpu as u32,
+            // GICC ONLINE_CAPABLE is bit 3, unlike the x86 LAPIC flag.
+            // Dormant CPUs are possible but must not boot before ACPI hot-add.
+            flags: hotplug_boot_vcpus.map_or(1, |boot| 8 | u32::from(cpu < boot as usize)),
+            parking_version: 0,
+            performance_interrupt: 0,
+            parked_address: 0,
+            base_address: cpu_interface_address,
+            gicv_base_address: 0,
+            gich_base_address: 0,
+            vgic_interrupt: 0,
+            gicr_base_address: 0,
+            mpidr: mpidr & 0xff_00ff_ffff,
+            proc_power_effi_class: 0,
+            reserved1: 0,
+            spe_overflow_interrupt: 0,
+        });
+    }
+
+    madt.append(GicD {
+        r#type: acpi::ACPI_APIC_GENERIC_DISTRIBUTOR,
+        length: 24,
+        reserved0: 0,
+        gic_id: 0,
+        base_address: registers[0],
+        global_irq_base: 0,
+        version: match version {
+            GicVersion::V2 => 2,
+            GicVersion::V3 => 3,
+        },
+        reserved1: [0; 3],
+    });
+
+    if version == GicVersion::V3 {
+        madt.append(GicR {
+            r#type: acpi::ACPI_APIC_GENERIC_REDISTRIBUTOR,
+            length: 16,
+            reserved: 0,
+            base_address: registers[2],
+            range_length: registers[3] as u32,
+        });
+    }
+
+    if let Some((compatibility, msi_registers)) = msi {
+        if compatibility == GIC_V2M_COMPATIBLE {
+            madt.append(GicMsiFrame {
+                r#type: acpi::ACPI_APIC_GIC_MSI_FRAME,
+                length: 24,
+                reserved0: 0,
+                msi_frame_id: 0,
+                base_address: msi_registers[0],
+                flags: 1,
+                spi_count: GICV2M_SPI_NUM as u16,
+                spi_base: GICV2M_SPI_BASE as u16,
+            });
+        } else if version == GicVersion::V3 {
+            madt.append(GicIts {
+                r#type: acpi::ACPI_APIC_GENERIC_TRANSLATOR,
+                length: 20,
+                reserved0: 0,
+                translation_id: 0,
+                base_address: msi_registers[0],
+                reserved1: 0,
+            });
+        }
+    }
+    madt.update_checksum();
 }
 
