--- /dev/null
+++ b/hypervisor/src/kvm/aarch64/gic/v2m.rs
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: Apache-2.0
+
+use std::io;
+
+use kvm_bindings::{KVM_IRQ_ROUTING_IRQCHIP, KVM_IRQ_ROUTING_MSI, kvm_irq_routing_entry};
+
+const MSI_SETSPI_NS: u64 = 0x40;
+const SPI_MASK: u32 = 0x3ff;
+const PRIVATE_IRQ_COUNT: u32 = 32;
+
+/// KVM's ARM MSI route injects through an ITS, which GICv2 does not have.
+/// Translate the frame's MSI message into an SPI route before installing irqfds.
+pub(crate) fn translate_msi_route(
+    entry: kvm_irq_routing_entry,
+    frame_addr: u64,
+    spi_base: u32,
+    spi_count: u32,
+) -> io::Result<kvm_irq_routing_entry> {
+    if entry.type_ != KVM_IRQ_ROUTING_MSI {
+        return Ok(entry);
+    }
+
+    let spi_end = spi_base
+        .checked_add(spi_count)
+        .filter(|end| spi_base >= PRIVATE_IRQ_COUNT && spi_count > 0 && *end <= 1020);
+    let spi_end = spi_end
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "Invalid GICv2m SPI range"))?;
+    let setspi_addr = frame_addr.checked_add(MSI_SETSPI_NS).ok_or_else(|| {
+        io::Error::new(io::ErrorKind::InvalidInput, "Invalid GICv2m frame address")
+    })?;
+
+    // SAFETY: The routing type above identifies the active MSI union member.
+    let msi = unsafe { entry.u.msi };
+    let address = (u64::from(msi.address_hi) << 32) | u64::from(msi.address_lo);
+    // MSI_SETSPI_NS uses bits [9:0]; match the MMIO device's treatment of RES0 bits.
+    let spi = msi.data & SPI_MASK;
+    if address != setspi_addr || !(spi_base..spi_end).contains(&spi) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            format!("Invalid GICv2m MSI address {address:#x} or SPI {spi}"),
+        ));
+    }
+
+    // Build a fresh entry so MSI-only flags and device IDs cannot leak into it.
+    let mut translated = kvm_irq_routing_entry {
+        gsi: entry.gsi,
+        type_: KVM_IRQ_ROUTING_IRQCHIP,
+        ..Default::default()
+    };
+    translated.u.irqchip.irqchip = 0;
+    // ARM KVM's IRQCHIP pin is relative to the first SPI, not an absolute INTID.
+    translated.u.irqchip.pin = spi - PRIVATE_IRQ_COUNT;
+    Ok(translated)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const FRAME: u64 = 0x08ff_c000;
+    const SPI_BASE: u32 = 128;
+    const SPI_COUNT: u32 = 64;
+
+    fn msi(address: u64, data: u32) -> kvm_irq_routing_entry {
+        let mut entry = kvm_irq_routing_entry {
+            gsi: 27,
+            type_: KVM_IRQ_ROUTING_MSI,
+            flags: kvm_bindings::KVM_MSI_VALID_DEVID,
+            ..Default::default()
+        };
+        entry.u.msi.address_lo = address as u32;
+        entry.u.msi.address_hi = (address >> 32) as u32;
+        entry.u.msi.data = data;
+        entry.u.msi.__bindgen_anon_1.devid = 0x1234;
+        entry
+    }
+
+    #[test]
+    fn test_v2m_route_first_and_last_spi() {
+        for spi in [SPI_BASE, SPI_BASE + SPI_COUNT - 1] {
+            let entry =
+                translate_msi_route(msi(FRAME + MSI_SETSPI_NS, spi), FRAME, SPI_BASE, SPI_COUNT)
+                    .unwrap();
+            assert_eq!(entry.gsi, 27);
+            assert_eq!(entry.type_, KVM_IRQ_ROUTING_IRQCHIP);
+            assert_eq!(entry.flags, 0);
+            // SAFETY: The translated entry is explicitly tagged as IRQCHIP.
+            let route = unsafe { entry.u.irqchip };
+            assert_eq!(route.irqchip, 0);
+            assert_eq!(route.pin, spi - PRIVATE_IRQ_COUNT);
+        }
+    }
+
+    #[test]
+    fn test_v2m_route_matches_mmio_reserved_bits() {
+        let entry = translate_msi_route(
+            msi(FRAME + MSI_SETSPI_NS, 0xffff_fc00 | SPI_BASE),
+            FRAME,
+            SPI_BASE,
+            SPI_COUNT,
+        )
+        .unwrap();
+        // SAFETY: The translated entry is explicitly tagged as IRQCHIP.
+        assert_eq!(unsafe { entry.u.irqchip.pin }, SPI_BASE - PRIVATE_IRQ_COUNT);
+    }
+
+    #[test]
+    fn test_v2m_route_rejects_invalid_messages() {
+        for address in [
+            FRAME,
+            FRAME + MSI_SETSPI_NS + 2,
+            FRAME + 0x1000 + MSI_SETSPI_NS,
+            (1_u64 << 32) | (FRAME + MSI_SETSPI_NS),
+        ] {
+            assert!(
+                translate_msi_route(msi(address, SPI_BASE), FRAME, SPI_BASE, SPI_COUNT).is_err()
+            );
+        }
+        for spi in [0, 31, SPI_BASE - 1, SPI_BASE + SPI_COUNT, 1023] {
+            assert!(
+                translate_msi_route(msi(FRAME + MSI_SETSPI_NS, spi), FRAME, SPI_BASE, SPI_COUNT)
+                    .is_err()
+            );
+        }
+    }
+
+    #[test]
+    fn test_v2m_route_rejects_invalid_configuration() {
+        for (base, count) in [(31, 1), (128, 0), (1019, 2), (u32::MAX, 2)] {
+            assert!(
+                translate_msi_route(msi(FRAME + MSI_SETSPI_NS, 128), FRAME, base, count).is_err()
+            );
+        }
+        assert!(translate_msi_route(msi(0, 128), u64::MAX, SPI_BASE, SPI_COUNT).is_err());
+    }
+
+    #[test]
+    fn test_v2m_route_preserves_legacy_entry() {
+        let mut entry = kvm_irq_routing_entry {
+            gsi: 9,
+            type_: KVM_IRQ_ROUTING_IRQCHIP,
+            ..Default::default()
+        };
+        entry.u.irqchip.pin = 1;
+        let translated = translate_msi_route(entry, FRAME, SPI_BASE, SPI_COUNT).unwrap();
+        assert_eq!(translated.gsi, entry.gsi);
+        assert_eq!(translated.type_, entry.type_);
+        // SAFETY: Both entries are explicitly tagged as IRQCHIP.
+        assert_eq!(unsafe { translated.u.irqchip.pin }, 1);
+    }
+}
