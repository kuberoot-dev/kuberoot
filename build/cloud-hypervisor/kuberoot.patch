--- /dev/null
+++ b/cloud-hypervisor/src/host_capabilities.rs
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: Apache-2.0
+
+use hypervisor::HypervisorType;
+use serde_json::{Value, json};
+use thiserror::Error;
+
+#[derive(Debug, Error)]
+pub enum Error {
+    #[error("Failed to open the host hypervisor")]
+    Open(#[source] hypervisor::HypervisorError),
+    #[cfg(all(target_arch = "aarch64", feature = "kvm"))]
+    #[error("Failed to create the capability probe VM")]
+    CreateVm(#[source] hypervisor::HypervisorError),
+    #[cfg(all(target_arch = "aarch64", feature = "kvm"))]
+    #[error("Failed to query the preferred virtual GIC")]
+    QueryGic(#[source] hypervisor::HypervisorVmError),
+}
+
+fn describe(architecture: &str, backend: &str, preferred_gic: Option<u8>) -> Value {
+    let hotadd = architecture == "aarch64" && backend == "kvm" && preferred_gic == Some(2);
+    let capabilities: &[&str] = if hotadd {
+        &["arm-gicv2-acpi-cpu-hotadd-v1"]
+    } else {
+        &[]
+    };
+    json!({
+        "schema_version": 1,
+        "architecture": architecture,
+        "backend": backend,
+        "preferred_gic": preferred_gic,
+        "capabilities": capabilities,
+        "maximum_hotadd_vcpus": if hotadd { 8 } else { 0 },
+    })
+}
+
+/// Query this binary's capabilities on the current host without starting a VMM.
+pub fn query() -> Result<Value, Error> {
+    let hypervisor = hypervisor::new().map_err(Error::Open)?;
+    let backend = match hypervisor.hypervisor_type() {
+        #[cfg(feature = "kvm")]
+        HypervisorType::Kvm => "kvm",
+        #[cfg(feature = "mshv")]
+        HypervisorType::Mshv => "mshv",
+    };
+    #[cfg(all(target_arch = "aarch64", feature = "kvm"))]
+    let preferred_gic = if hypervisor.hypervisor_type() == HypervisorType::Kvm {
+        use hypervisor::arch::aarch64::gic::GicVersion;
+
+        // Use the launch path's VM type and selector. The temporary VM has no
+        // vCPUs or guest memory; the selector uses KVM_CREATE_DEVICE_TEST and
+        // falls back from V3 to V2 only for ENODEV. All fds close on return.
+        let vm = hypervisor
+            .create_vm(hypervisor::HypervisorVmConfig::default())
+            .map_err(Error::CreateVm)?;
+        Some(match vm.get_vgic_version().map_err(Error::QueryGic)? {
+            GicVersion::V2 => 2,
+            GicVersion::V3 => 3,
+        })
+    } else {
+        None
+    };
+    #[cfg(not(all(target_arch = "aarch64", feature = "kvm")))]
+    let preferred_gic = None;
+
+    Ok(describe(std::env::consts::ARCH, backend, preferred_gic))
+}
+
+#[cfg(test)]
+mod tests {
+    use serde_json::json;
+
+    use super::describe;
+
+    #[test]
+    fn test_host_capabilities_v2_schema() {
+        assert_eq!(
+            describe("aarch64", "kvm", Some(2)),
+            json!({
+                "schema_version": 1,
+                "architecture": "aarch64",
+                "backend": "kvm",
+                "preferred_gic": 2,
+                "capabilities": ["arm-gicv2-acpi-cpu-hotadd-v1"],
+                "maximum_hotadd_vcpus": 8,
+            })
+        );
+    }
+
+    #[test]
+    fn test_host_capabilities_no_hotadd_for_other_hosts() {
+        for (architecture, backend, gic) in [
+            ("aarch64", "kvm", Some(3)),
+            ("aarch64", "mshv", None),
+            ("aarch64", "mshv", Some(2)),
+            ("x86_64", "kvm", None),
+            ("x86_64", "kvm", Some(2)),
+            ("riscv64", "kvm", None),
+        ] {
+            let result = describe(architecture, backend, gic);
+            assert_eq!(result.as_object().unwrap().len(), 6);
+            assert_eq!(result["capabilities"], json!([]));
+            assert_eq!(result["maximum_hotadd_vcpus"], 0);
+            assert_eq!(result["preferred_gic"], json!(gic));
+        }
+    }
+}
