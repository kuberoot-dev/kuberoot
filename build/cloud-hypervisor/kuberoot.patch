+    fn gic_madt_records(madt: &Sdt) -> Vec<&[u8]> {
+        let bytes = madt.as_slice();
+        assert_eq!(&bytes[..4], b"APIC");
+        assert_eq!(
+            u32::from_le_bytes(bytes[4..8].try_into().unwrap()) as usize,
+            bytes.len()
+        );
