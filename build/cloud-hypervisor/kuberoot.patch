+++ b/vmm/src/cpu/arm_hotplug.rs
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: Apache-2.0 AND BSD-3-Clause
+
+//! Snapshot metadata for the opt-in ARM CPU hot-add path.
+
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Deserialize, Serialize)]
+pub(super) struct HotplugState {
+    pub version: u32,
+    pub allocated: u32,
+    pub active: u32,
+    pub inserting: Vec<u32>,
+    pub notification_pending: bool,
+}
+
+impl HotplugState {
+    pub fn validate(&self, maximum: u32) -> Result<(), &'static str> {
+        if self.version != 1 || self.allocated != maximum || !(1..=8).contains(&maximum) {
+            return Err("Unsupported CPU hot-add snapshot version or capacity");
+        }
+        if self.active == 0 || self.active > maximum {
+            return Err("Invalid active CPU prefix in hot-add snapshot");
+        }
+        let mut seen = 0_u16;
+        for id in &self.inserting {
+            if *id >= self.active || seen & (1 << *id) != 0 {
+                return Err("Invalid insertion bitmap in hot-add snapshot");
+            }
+            seen |= 1 << *id;
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_arm_hotplug_snapshot_active_prefix_and_invalid_metadata() {
+        let mut state = HotplugState {
+            version: 1,
+            allocated: 4,
+            active: 2,
+            inserting: vec![1],
+            notification_pending: true,
+        };
+        let copy: HotplugState =
+            serde_json::from_str(&serde_json::to_string(&state).unwrap()).unwrap();
+        copy.validate(4).unwrap();
+        assert_eq!(copy.active, 2);
+        assert_eq!(copy.inserting, [1]);
+        assert!(copy.notification_pending);
+        assert!(copy.validate(8).is_err());
+        state.inserting.push(1);
+        assert!(state.validate(4).is_err());
+        state.inserting = vec![2];
+        assert!(state.validate(4).is_err());
+        state.inserting.clear();
+        state.active = 0;
+        assert!(state.validate(4).is_err());
+        state.active = 5;
+        assert!(state.validate(4).is_err());
+        state.active = 2;
+        state.version = 2;
+        assert!(state.validate(4).is_err());
+    }
+}
