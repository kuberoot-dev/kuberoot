+++ b/vmm/src/cpu/startup.rs
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: Apache-2.0
+
+//! Prepare every thread before publishing a vCPU batch and entering the guest.
+//! A failed setup or readiness timeout aborts peers waiting for publication.
+
+use std::sync::{Arc, Condvar, Mutex};
+use std::time::{Duration, Instant};
+
+#[derive(Default)]
+struct GateState {
+    ready: usize,
+    released: bool,
+    aborted: bool,
+}
+
+#[derive(Default)]
+pub(super) struct StartGate {
+    state: Mutex<GateState>,
+    changed: Condvar,
+}
+
+impl StartGate {
+    pub fn aborted(&self) -> bool {
+        self.state.lock().unwrap().aborted
+    }
+
+    pub fn abort(&self) {
+        self.state.lock().unwrap().aborted = true;
+        self.changed.notify_all();
+    }
+
+    pub fn wait_ready(&self, count: usize, timeout: Duration) -> Result<(), &'static str> {
+        let deadline = Instant::now() + timeout;
+        let mut state = self.state.lock().unwrap();
+        loop {
+            if state.aborted {
+                return Err("A vCPU thread failed during startup");
+            }
+            if state.ready == count {
+                return Ok(());
+            }
+            let remaining = deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                state.aborted = true;
+                self.changed.notify_all();
+                return Err("Timed out waiting for vCPU thread readiness");
+            }
+            (state, _) = self.changed.wait_timeout(state, remaining).unwrap();
+        }
+    }
+
+    /// Called only after the whole ready batch has been published.
+    pub fn release(&self) {
+        self.state.lock().unwrap().released = true;
+        self.changed.notify_all();
+    }
+}
+
+pub(super) struct StartupParticipant {
+    gate: Arc<StartGate>,
+    ready: bool,
+}
+
+impl StartupParticipant {
+    pub fn new(gate: Arc<StartGate>) -> Self {
+        Self { gate, ready: false }
+    }
+
+    pub fn aborted(&self) -> bool {
+        self.gate.aborted()
+    }
+
+    pub fn wait(&mut self) -> bool {
+        let mut state = self.gate.state.lock().unwrap();
+        self.ready = true;
+        state.ready += 1;
+        self.gate.changed.notify_all();
+        while !state.released && !state.aborted {
+            state = self.gate.changed.wait(state).unwrap();
+        }
+        !state.aborted
+    }
+}
+
+impl Drop for StartupParticipant {
+    fn drop(&mut self) {
+        if !self.ready {
+            self.gate.abort();
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::sync::mpsc;
+    use std::thread;
+
+    use super::*;
+
+    #[test]
+    fn test_cpu_startup_ready_batch_waits_for_publication() {
+        let gate = Arc::new(StartGate::default());
+        let ran = Arc::new(AtomicUsize::new(0));
+        let children: Vec<_> = (0..2)
+            .map(|_| {
+                let child_gate = gate.clone();
+                let child_ran = ran.clone();
+                thread::spawn(move || {
+                    if StartupParticipant::new(child_gate).wait() {
+                        child_ran.fetch_add(1, Ordering::SeqCst);
+                    }
+                })
+            })
+            .collect();
+        gate.wait_ready(2, Duration::from_secs(5)).unwrap();
+        assert_eq!(ran.load(Ordering::SeqCst), 0);
+        gate.release();
+        for child in children {
+            child.join().unwrap();
+        }
+        assert_eq!(ran.load(Ordering::SeqCst), 2);
+    }
+
+    #[test]
+    fn test_cpu_startup_setup_failure_aborts_ready_peer() {
+        let gate = Arc::new(StartGate::default());
+        let child_gate = gate.clone();
+        let child = thread::spawn(move || StartupParticipant::new(child_gate).wait());
+        gate.wait_ready(1, Duration::from_secs(5)).unwrap();
+        // The second thread returns during setup (affinity/seccomp failure).
+        let failed_gate = gate.clone();
+        thread::spawn(move || drop(StartupParticipant::new(failed_gate)))
+            .join()
+            .unwrap();
+        assert_eq!(
+            gate.wait_ready(2, Duration::from_secs(5)),
+            Err("A vCPU thread failed during startup")
+        );
+        assert!(!child.join().unwrap());
+    }
+
+    #[test]
+    fn test_cpu_startup_timeout_releases_already_ready_threads() {
+        let gate = Arc::new(StartGate::default());
+        let child_gate = gate.clone();
+        let child = thread::spawn(move || StartupParticipant::new(child_gate).wait());
+        gate.wait_ready(1, Duration::from_secs(5)).unwrap();
+        // A missing or unscheduled second thread cannot strand the first.
+        assert_eq!(
+            gate.wait_ready(2, Duration::ZERO),
+            Err("Timed out waiting for vCPU thread readiness")
+        );
+        assert!(!child.join().unwrap());
+        assert!(!StartupParticipant::new(gate.clone()).wait());
+        // A delayed publication cannot revive an aborted batch.
+        gate.release();
+        assert!(!StartupParticipant::new(gate).wait());
+    }
+
+    #[test]
+    fn test_cpu_startup_setup_panic_aborts_ready_peer() {
+        let gate = Arc::new(StartGate::default());
+        let child_gate = gate.clone();
+        let child = thread::spawn(move || StartupParticipant::new(child_gate).wait());
+        gate.wait_ready(1, Duration::from_secs(5)).unwrap();
+        let failed_gate = gate.clone();
+        assert!(
+            thread::spawn(move || {
+                let _participant = StartupParticipant::new(failed_gate);
+                panic!("Simulated pre-start setup panic");
+            })
+            .join()
+            .is_err()
+        );
+        assert!(gate.wait_ready(2, Duration::from_secs(5)).is_err());
+        assert!(!child.join().unwrap());
+    }
+
+    #[test]
+    fn test_cpu_startup_abort_interrupts_core_scheduling_wait() {
+        let gate = Arc::new(StartGate::default());
+        let child_gate = gate.clone();
+        let (started_tx, started_rx) = mpsc::channel();
+        let (stopped_tx, stopped_rx) = mpsc::channel();
+        let child = thread::spawn(move || {
+            let participant = StartupParticipant::new(child_gate);
+            started_tx.send(()).unwrap();
+            // Mirrors waiting for the core-scheduling leader before ready.
+            while !participant.aborted() {
+                thread::yield_now();
+            }
+            stopped_tx.send(()).unwrap();
+        });
+        started_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+        assert!(gate.wait_ready(1, Duration::ZERO).is_err());
+        stopped_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+        child.join().unwrap();
+    }
+
+    #[test]
+    fn test_cpu_startup_spawn_failure_abort_allows_fresh_batch() {
+        let failed = Arc::new(StartGate::default());
+        let peer_gate = failed.clone();
+        let peer = thread::spawn(move || StartupParticipant::new(peer_gate).wait());
+        failed.wait_ready(1, Duration::from_secs(5)).unwrap();
+        // The manager observes a spawn error before a participant exists.
+        failed.abort();
+        assert!(!peer.join().unwrap());
+
+        let retry = Arc::new(StartGate::default());
+        let retry_gate = retry.clone();
+        let child = thread::spawn(move || StartupParticipant::new(retry_gate).wait());
+        retry.wait_ready(1, Duration::from_secs(5)).unwrap();
+        retry.release();
+        assert!(child.join().unwrap());
+    }
+}
