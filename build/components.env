# Upstream components bundled into the kuberoot root filesystem.
K8S_VERSION=v1.37.1
CONTAINERD_VERSION=2.4.1
RUNC_VERSION=v1.5.2
CNI_VERSION=v1.9.1
KINE_VERSION=v0.17.1
# The store of a highly available control plane, as kubeadm 1.37 runs it.
ETCD_VERSION=v3.7.2
COREDNS_IMAGE=registry.k8s.io/coredns/coredns:v1.14.7
ALPINE_VERSION=3.22
# The hypervisor distribution's virtual machine monitor and its UEFI firmware.
CLOUD_HYPERVISOR_VERSION=v53.0
CLOUDHV_FIRMWARE_VERSION=ch-97eeb7b09
# The ai distribution's model server.
LLAMA_CPP_VERSION=v0.6.0
# The rt distribution's latency measurement.
RT_TESTS_VERSION=2.11
# The ai distribution's NVIDIA driver: the open kernel modules and the user
# space of the same release.
NVIDIA_DRIVER_VERSION=580.178.04
# CUDA for llama-server on NVIDIA GPUs: only the parts a build needs.
CUDA_REDIST_VERSION=12.9.1
# The CDI hook of the NVIDIA Container Toolkit: refreshes the loader's cache
# in containers given the driver's libraries.
NVIDIA_CONTAINER_TOOLKIT_VERSION=v1.20.1
# The workstation distribution's browser client for desktops.
NOVNC_VERSION=v1.7.0
