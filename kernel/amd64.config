# amd64: Hyper-V guest support beyond the drivers in base.config. The guest
# side of the hypervisor interface (Hyper-V's timer comes with it), and its
# synthetic video through DRM, which defconfig builds in: the framebuffer
# driver of the same device is deprecated, and the two would claim it in turn.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_DRM_HYPERV=y
# CONFIG_FB_HYPERV is not set
