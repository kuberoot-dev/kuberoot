# Kernel fragment shared by every kuberoot distro: what a Kubernetes node needs.
# Everything is built in; distros extend this with their own fragment.
# Modules exist only for out-of-tree drivers built with the kernel (DRBD 9):
# they must be signed with this build's key, kinit loads them at boot and then
# disables module loading for the rest of the run.
CONFIG_MODULES=y
# CONFIG_MODULE_UNLOAD is not set
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
# CONFIG_BLK_DEV_DRBD is not set
CONFIG_LOCALVERSION="-kuberoot"
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# Namespaces
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_PSI=y
CONFIG_KEYS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_POSIX_MQUEUE=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_HAVE_EBPF_JIT=y
# The kernel's own type information, published at /sys/kernel/btf/vmlinux.
# A program compiled once and run on another kernel reads its types from
# there instead of from headers it was built against, which is how Cilium and
# every other current eBPF user ship a single object. Without it they refuse
# to load. It selects CONFIG_DEBUG_INFO and needs pahole at build time; the
# debug information stays in the intermediate objects, and only the .BTF
# section reaches the image.
CONFIG_DEBUG_INFO_BTF=y
# Perf events carry what an eBPF program reports back to user space: the
# per-CPU ring buffers behind `cilium monitor` and Hubble's flow events.
CONFIG_PERF_EVENTS=y
# Networking
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_VXLAN=y
CONFIG_GENEVE=y
CONFIG_TUN=y
CONFIG_DUMMY=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_COMPAT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP_VS=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_NFCT=y
# Virtual hardware (QEMU / KubeVirt)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SCSI_VIRTIO=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_BALLOON=y
# Immutable root: squashfs image on a loop device
CONFIG_BLK_DEV_LOOP=y
# nftables features used by kube-proxy (nftables mode) and the bridge CNI
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_QUOTA=y
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
# What Cilium needs beyond the rest: BPF tc actions, the kernel crypto API
# its agent hashes with, IPsec, fair queueing for its bandwidth manager,
# netkit devices and sockmap.
CONFIG_NET_ACT_BPF=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_INET_ESP=y
CONFIG_NET_SCH_FQ=y
CONFIG_NETKIT=y
CONFIG_BPF_STREAM_PARSER=y
# SNAT and DNAT targets for iptables-nft: CNI agents install NAT rules this
# way (Cilium's SNAT); the tables themselves are set above.
CONFIG_NETFILTER_XT_NAT=y
# Algorithms DRBD and LINSTOR use: SHA-1 for the peers' HMAC authentication,
# CRC32C for checksums.
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_CRC32C=y
# Routing: VLAN links (802.1Q), policy routing for IPv6 as for IPv4, and
# FQ-CoDel, a queue that keeps latency low under load.
CONFIG_VLAN_8021Q=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NET_SCH_FQ_CODEL=y
# Virtual machines on KVM (the hypervisor distribution), with vhost-net
# for their network and loop devices for disk images.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_AMD=y
CONFIG_KVM_INTEL=y
CONFIG_VHOST_NET=y
CONFIG_BLK_DEV_LOOP=y
# Serial lines to field devices (Modbus RTU): USB to RS-232/RS-485
# adapters, FTDI, CH34x, CP210x and PL2303, and CDC ACM devices that show
# up as /dev/ttyACM*; on-board UARTs are the 8250 driver's.
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_ACM=y
CONFIG_SERIAL_8250=y
