# riscv64: a node for virtual machines and emulators, QEMU's virt machine
# and machines like it: RV64GC with Sv39 under OpenSBI, devices on virtio
# (MMIO or PCI), described by a device tree. Neither the vector nor the
# hypervisor extension is needed: the kernel uses vector only if the CPU
# reports it. The image is the kernel's own Image, which is also an EFI
# program, so it boots both from OpenSBI directly (with an initrd) and
# from UEFI firmware through systemd-boot.
CONFIG_ARCH_VIRT=y
# Only the virt platform: riscv64's defconfig enables every board family,
# and kuberoot builds in what defconfig makes modules.
# CONFIG_ARCH_ANDES is not set
# CONFIG_ARCH_CANAAN is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SIFIVE is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_SPACEMIT is not set
# CONFIG_ARCH_STARFIVE is not set
# CONFIG_SOC_STARFIVE is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_THEAD is not set
# No hypervisor extension is asked of the CPU, so no KVM.
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# A device tree describes the machine; there is no ACPI to read.
# CONFIG_ACPI is not set
# The console: the virt machine's 16550 UART, the SBI console where an
# emulator offers nothing else, and virtio's (hvc0).
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_VIRTIO_CONSOLE=y
# The clock: the node issues certificates at boot and has no NTP, so it
# needs the real time from the machine's RTC (goldfish on the virt machine).
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_GOLDFISH=y
# Power off and reboot through SBI and the virt machine's syscon.
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_SYSCON_REBOOT_MODE=y
# virtio only: block, network, console, entropy, balloon, 9p.
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
# No other hardware: no screen, sound, USB, SD cards, flash, I2C, SPI,
# GPIO, SATA or physical network cards.
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MMC is not set
# CONFIG_MTD is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_GPIOLIB is not set
# CONFIG_PWM is not set
# CONFIG_IIO is not set
# CONFIG_ATA is not set
# CONFIG_BLK_DEV_SR is not set
# CONFIG_CAN is not set
# CONFIG_RPMSG is not set
# CONFIG_LIBNVDIMM is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_PM_DEVFREQ is not set
# CONFIG_THERMAL is not set
# CONFIG_REGULATOR is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_VIRTIO_INPUT is not set
# CONFIG_DMADEVICES is not set
# CONFIG_WATCHDOG is not set
# CONFIG_ETHERNET is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_PHYLIB is not set
# CONFIG_MDIO_DEVICE is not set
# Filesystems the node does not use.
# CONFIG_BTRFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_ROOT_NFS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_AUTOFS_FS is not set
# No security modules beyond what containers use (seccomp, capabilities).
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_APPARMOR is not set
# No debug information, and so no BTF: the riscv64 node runs the built-in
# pod network, not eBPF programs that read the kernel's types, and debug
# information would make the kernel's build several times larger.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_MEMTEST is not set
# defconfig's crypto benchmark can only be a module, and none is wanted.
# CONFIG_CRYPTO_BENCHMARK is not set
