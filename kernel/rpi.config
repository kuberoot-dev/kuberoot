# Raspberry Pi 4 (BCM2711) and 5 (BCM2712), on top of kernel/arm64.config.
#
# arm64.config already selects the platform (ARCH_BCM2835 covers both), but it
# was written for virtual machines, where every device is virtio. A board needs
# its own drivers, and without them the kernel boots to a point where it can
# find neither a disk nor a network and says so only on a serial console nobody
# is watching. Everything here is built in rather than modular: the root
# filesystem lives on one of these devices, so a module for it would have to be
# in the initramfs anyway, and the squashfs image is small enough that the few
# megabytes do not matter.
#
# The Pi has no ACPI. It is described entirely by a devicetree, which the
# firmware loads and hands to the kernel, so OF support and the matching .dtb
# have to be there -- see scripts/build-kernel.sh, which builds and ships them.

# --- storage ---------------------------------------------------------------
# The SD card, on both boards: BCM2711 and BCM2712 both expose the Arasan
# controller that sdhci-iproc drives. MMC_BCM2835 is the older, separate SD
# host the firmware may hand over instead, depending on config.txt; carrying
# both costs little and avoids a board that boots on one setting and not the
# other.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_MMC_BCM2835=y

# NVMe over the PCIe HAT, which is where the storage pools live: a pool needs a
# device of its own, and neither the boot medium nor the system disk can be
# one.
CONFIG_PCIE_BRCMSTB=y
CONFIG_BLK_DEV_NVME=y

# USB, for a disk or a keyboard during bring-up. On the Pi 4 the xHCI
# controller is a VL805 behind PCIe, which is why the PCI glue is needed and
# not just the platform one.
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_STORAGE=y

# --- network ---------------------------------------------------------------
# Pi 4: GENET on the SoC, with a Broadcom PHY.
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_BCMGENET=y
CONFIG_BROADCOM_PHY=y

# Pi 5: the MAC sits inside RP1, the southbridge on the far side of PCIe, and
# is a Cadence GEM -- the same IP the macb driver has handled for years.
CONFIG_NET_VENDOR_CADENCE=y
CONFIG_MACB=y

# RP1 itself, and it is worth naming rather than leaning on: nothing inside it
# is discoverable over PCIe, so the driver declares the sub-devices through a
# devicetree overlay and only then do the Ethernet and USB controllers appear.
# Without it the Pi 5 comes up with no network and no USB, and with no error
# either -- the devices were never probed, so nothing failed.
#
# These are all enabled by the kernel's own defaults today, which is exactly
# why they are written down: a default is not a decision, and the day it
# changes, Pi 5 support leaves without a word. Listed here, the build fails
# instead -- the check after olddefconfig only guards what the fragments ask
# for.
CONFIG_MISC_RP1=y
CONFIG_COMMON_CLK_RP1=y
CONFIG_PINCTRL_RP1=y
CONFIG_OF_OVERLAY=y
CONFIG_PCI_DYNAMIC_OF_NODES=y

# --- the SoC itself --------------------------------------------------------
# The firmware mailbox is the interface to everything the VideoCore side owns:
# clocks, power domains, the expander GPIOs that drive the Ethernet PHY reset
# and the activity LED. Leave it out and the peripherals that depend on it stay
# powered down.
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_GPIO_RASPBERRYPI_EXP=y
CONFIG_DMA_BCM2835=y
CONFIG_HW_RANDOM_BCM2835=y

# The watchdog is also the reset controller on these boards: without it the
# kernel has no way to restart the machine, and `reboot` leaves it wedged --
# which on a headless node in a cluster is indistinguishable from a crash.
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y

# The serial console. PL011 is already in arm64.config; the Pi may hand the
# primary UART to Bluetooth and leave the mini UART as the console instead,
# depending on config.txt, so both are built in.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_BCM2835AUX=y
